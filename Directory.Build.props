<Project>
  <PropertyGroup>
    <!-- Suppress preview .NET SDK diagnostic (NETSDK1057) -->
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <!-- Suppress NuGet readme authoring advisory (NU5125) -->
    <NoWarn>$(NoWarn);NU5125</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Force the native SQLite binary up from SQLitePCLRaw.lib.e_sqlite3 2.1.11 (CVE-2025-6965,
         NU1903) to the renamed SourceGear.sqlite3 package, which bundles a patched SQLite (3.50.4+).
         Microsoft.Data.Sqlite 10.0.9 still floors on the vulnerable 2.1.11 transitively. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>
</Project>
