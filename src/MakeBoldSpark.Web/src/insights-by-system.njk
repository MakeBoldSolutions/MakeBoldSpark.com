---
pagination:
  data: systems
  size: 1
  alias: system
permalink: "/insights/{{ system.id }}/index.html"
layout: layouts/base.njk
title: "{{ system.name }} Insights | Make Bold Spark"
description: "{{ system.name }} insights and related writing."
---
{% block content %}
<header class="hero page-hero"><div class="hero-inner single"><div class="hero-copy"><p class="eyebrow">{{ system.name }} Insights</p><h1>{{ system.name }} writing</h1><p class="hero-sub">Articles connected to {{ system.name }}, practical implementation, and repeatable workflows.</p></div></div></header>
<section class="section"><div class="grid">{% set related = collections.articles | selectattr('data.system', 'equalto', system.id) | list %}{% if related.length %}{% for article in related %}<article class="card article-card"><h3><a href="{{ article.url }}">{{ article.data.title }}</a></h3><p>{{ article.data.summary }}</p><div class="meta-row">{% for tag in article.data.tags %}<span class="tag">{{ tag }}</span>{% endfor %}</div></article>{% endfor %}{% else %}<article class="card"><h3>Insights are being prepared</h3><p>Migrated Markdown articles for {{ system.name }} will appear here as they are published.</p></article>{% endif %}</div></section>
{% endblock %}
