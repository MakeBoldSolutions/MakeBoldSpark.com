{
  "name": "makeboldspark-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-and-swap.mjs",
    "build:test": "node scripts/build-and-swap.mjs --output-root test/output",
    "lint:markdown": "node scripts/lint-markdown.mjs",
    "serve": "npx @11ty/eleventy --serve",
    "verify:live-reload": "node scripts/verify-live-reload.mjs",
    "test": "node scripts/verify-build.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "markdownlint-cli2": "0.23.3"
  },
  "overrides": {
    "markdownlint-cli2": {
      "smol-toml": "^1.9.0",
      "markdown-it": "^14.3.3",
      "js-yaml": "^5.4.1"
    },
    "katex": "^0.18.2"
  }
}
