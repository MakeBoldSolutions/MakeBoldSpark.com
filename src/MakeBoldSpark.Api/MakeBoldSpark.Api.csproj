<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <UserSecretsId>6e5e5de3-d222-43fa-b387-c5378df0a0b7</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MakeBoldSpark.Cms\MakeBoldSpark.Cms.csproj" />
    <ProjectReference Include="..\MakeBoldSpark.Core\MakeBoldSpark.Core.csproj" />
    <ProjectReference Include="..\MakeBoldSpark.Recipe\MakeBoldSpark.Recipe.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ApiTestSpark" Version="1.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.9.0" />
    <PackageReference Include="Polly" Version="8.7.0" />
  </ItemGroup>

  <Target Name="BuildStaticContent" BeforeTargets="Build">
    <!-- Validated for the current Windows workstation flow; re-verify before a CI/Kudu build-from-source deployment path is introduced. -->
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)\..\MakeBoldSpark.Web" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\..\MakeBoldSpark.Web" />
  </Target>

</Project>
